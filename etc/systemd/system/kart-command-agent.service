[Unit]
Description=Kart telemetry MQTT command agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/kart_performance_monitor
ExecStart=/home/pi/kart_performance_monitor/venv/bin/python -m src.raspi_command_center.agent
Restart=always
RestartSec=5
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
